# Production env for the docker-compose stack (VM + Postgres + Caddy).
# Copy to `.env` on the VM, chmod 600, fill in the real values, and never
# commit the filled-in version — it's already gitignored like the dev `.env`.
#
# Differences from the dev `.env.example` are called out inline. The env var
# NAMES this file defines are read by app/config.py; DOMAIN and
# POSTGRES_PASSWORD are consumed only by docker-compose.yml/Caddyfile, not
# by the app itself.

# --- Reverse proxy / TLS ---
# The DigitalPlat (or other) subdomain pointing at this VM's static IP.
# Caddy requests its Let's Encrypt cert for exactly this host.
DOMAIN=

# --- Database ---
# docker-compose.yml overrides DATABASE_URL to point at the sibling `db`
# container regardless of what's set here — this line only supplies the
# password both containers agree on.
POSTGRES_PASSWORD=

# --- JWT ---
# Generate a fresh value — do NOT reuse the dev SECRET_KEY.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
STORAGE_BACKEND=gcs
# The bucket created in the *consolidated* project (see deployment plan) —
# not the old two-project `docvault_bucket` used during development.
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# Deliberately unset: the VM's attached service account IS the ADC identity,
# so there is no key file to mount. See app/shared/storage/interface.py.
GCS_CREDENTIALS_PATH=

# --- OTP login (Firebase Phone Auth) ---
FIREBASE_PROJECT_ID=
# Deliberately unset — same ADC identity as GCS above.
FIREBASE_CREDENTIALS_PATH=
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# --- Encryption at rest (AES-256-GCM) ---
# Generate a fresh value — do NOT reuse the dev ENCRYPTION_KEY.
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# UNRECOVERABLE: every stored document is encrypted with this key. Losing it
# makes every document in the bucket permanently unreadable. Back it up to a
# password manager the moment it's generated, before the first real upload.
ENCRYPTION_KEY=

# --- CORS ---
# Leave empty unless/until a browser-based client exists.
CORS_ALLOWED_ORIGINS=

# --- Audit storage ---
AUDIT_SINK=per_table

# --- Business Rules (configurable per PRD §9) ---
MAX_UPLOAD_SIZE_BYTES=20971520
DAILY_UPLOAD_CAP=10
SOFT_DELETE_RETENTION_DAYS=10
GROUP_MEMBER_CAP=20
