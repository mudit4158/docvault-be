# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/docvault

# --- JWT ---
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
# "local" for development. "gcs" (Google Cloud Storage) is planned, not built.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# --- Encryption at rest (AES-256-GCM) ---
# 32 random bytes, URL-safe base64. Generate with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# In production keep this in a secret manager, never in a committed file.
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key

# --- Audit storage ---
AUDIT_SINK=per_table

# --- Business Rules (configurable per PRD §9) ---
MAX_UPLOAD_SIZE_BYTES=20971520
DAILY_UPLOAD_CAP=10
SOFT_DELETE_RETENTION_DAYS=10
GROUP_MEMBER_CAP=20
