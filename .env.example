# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/docvault

# --- JWT ---
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
# "local" for dev, "s3" for production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# For S3 backend
AWS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Business Rules (configurable per PRD §9) ---
MAX_UPLOAD_SIZE_BYTES=20971520
DAILY_UPLOAD_CAP=10
SOFT_DELETE_RETENTION_DAYS=10
GROUP_MEMBER_CAP=20
